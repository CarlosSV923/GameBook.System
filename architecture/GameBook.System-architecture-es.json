  "cards": [
    {
      "dot": "cyan",
      "title": "Superficie pública",
      "items": [
        "El navegador accede a IGDB mediante las rutas de Next.js.",
        "AuthUser y Game permanecen como servicios backend separados en Render.",
        "Los healthchecks preceden las llamadas del Frontend a ambos backends."
      ]
    },
    {
      "dot": "rose",
      "title": "Límite de identidad",
      "items": [
        "AuthUser firma JWT RS256 con sub, ver, iat, exp, iss y aud.",
        "Game verifica el JWT Bearer y confirma la sesión con AuthUser.",
        "sessionVersion e isDisabled aplican revocación y estado de cuenta."
      ]
    },
    {
      "dot": "emerald",
      "title": "Datos y servicios externos",
      "items": [
        "Neon contiene los esquemas auth y game con roles runtime restringidos.",
        "Twitch emite el token de aplicación usado por el cliente IGDB server-only.",
        "Las credenciales IGDB nunca llegan al navegador ni a los backends.",
        "Los controles fijos del visor siguen en inglés."
      ]
    }
  ]
