  "cards": [
    {
      "dot": "cyan",
      "title": "Public surface",
      "items": [
        "The browser reaches IGDB through Next.js route handlers.",
        "AuthUser and Game remain separate backend services on Render.",
        "Healthchecks precede Frontend calls to either backend."
      ]
    },
    {
      "dot": "rose",
      "title": "Identity boundary",
      "items": [
        "AuthUser signs RS256 JWTs with sub, ver, iat, exp, iss and aud.",
        "Game verifies the Bearer JWT and confirms the session with AuthUser.",
        "sessionVersion and isDisabled enforce revocation and account state."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data and external services",
      "items": [
        "Neon holds auth and game schemas with restricted runtime roles.",
        "Twitch issues the application token used by the server-only IGDB client.",
        "IGDB credentials never enter the browser or either backend."
      ]
    }
  ]
