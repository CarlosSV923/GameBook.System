  "cards": [
    {
      "dot": "rose",
      "title": "Server-only credentials",
      "items": [
        "Next.js renders the first catalog page and serves later /api/igdb requests.",
        "Twitch credentials and the cached application token stay on the Next.js server."
      ]
    },
    {
      "dot": "emerald",
      "title": "Database isolation",
      "items": [
        "AuthUser and Game share Neon while using separate schemas and limited runtime roles.",
        "GitHub Actions runs migrations independently for each service."
      ]
    },
    {
      "dot": "cyan",
      "title": "Documentation hub",
      "items": [
        "GameBook.System holds SDD records and local Docker Compose for the three applications.",
        "GitHub Pages indexes architecture diagrams from all four repositories."
      ]
    }
