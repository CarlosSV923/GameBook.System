# Local PostgreSQL is the default database for the Compose stack.
POSTGRES_DB=gamebook
POSTGRES_USER=gamebook
POSTGRES_PASSWORD=gamebook-local
POSTGRES_PORT=5432

# Optional host port overrides.
AUTHUSER_PORT=3001
GAME_PORT=3002
FRONTEND_PORT=3000

# Runtime database URLs. Override these explicitly only when using another database, such as Neon.
AUTH_DATABASE_URL=postgresql://gamebook:gamebook-local@postgres:5432/gamebook?schema=auth
GAME_DATABASE_URL=postgresql://gamebook:gamebook-local@postgres:5432/gamebook?schema=game

# Local RS256 values. Keep the private key out of Git; use literal \n escapes in this file.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=gamebook-local
JWT_AUDIENCE=gamebook-local-clients

# Docker-internal AuthUser URL for Game.
AUTHUSER_URL=http://authuser:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Browser-facing URLs are baked into the Frontend image at build time.
NEXT_PUBLIC_AUTHUSER_URL=http://localhost:3001
NEXT_PUBLIC_GAME_URL=http://localhost:3002

# Server-only IGDB/Twitch credentials. Required for the public catalog.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
